# Local dev: public Postgres connection string
# On Rumpty deployment: use the internal connection string (app and DB both on Rumpty)
# Neon: paste the connection string from the Neon dashboard (add ?sslmode=require
# if Neon's string does not already include it).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tenura

# --- Accounts -----------------------------------------------------------------
# Signs every session cookie. REQUIRED in production: if it is missing the app
# generates a random one per process, which signs everyone out on every restart.
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=replace-me-with-a-long-random-value

# "production" makes a missing email provider a hard error instead of silently
# logging codes to the console. Leave unset for local development.
# APP_ENV=production

# Cookies are Secure by default (HTTPS only). Plain-http local development needs
# this set to false, or the browser will never send the cookie back.
SESSION_COOKIE_SECURE=false

# --- Email (one-time codes) ---------------------------------------------------
# Resend (https://resend.com). EMAIL_FROM must be on a domain you have verified
# with the provider, in the form:  Tenura <no-reply@yourdomain.com>
EMAIL_PROVIDER=resend
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=Tenura <no-reply@yourdomain.com>

# For local development without a provider account, use instead:
#   EMAIL_PROVIDER=console
# which prints the code to the server log and sends nothing. It has to be asked
# for by name (so no code is ever logged by accident) and it is refused outright
# when APP_ENV=production.

# --- Sign in with Google (optional) -------------------------------------------
# Enables "Continue with Google" on the login and sign-up pages. This uses the
# server-side redirect (authorization code) flow, so no Google script is ever
# loaded into the page and the privacy policy's "no external scripts" promise
# stays true. Create an OAuth 2.0 client of type "Web application" in the Google
# Cloud console and add the callback below as an *Authorized redirect URI*:
#     https://<your-host>/api/auth/google/callback
# (A JavaScript origin is not needed, and does nothing for this flow.) Read at
# startup; if either value is missing the button is simply not shown, and
# /api/auth/google/start answers 404.
# GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Optional: pin the callback instead of deriving it from the request host. Set it
# when the app is reachable on more than one hostname and you would rather not
# register each one.
# GOOGLE_REDIRECT_URI=https://www.tenura.online/api/auth/google/callback

# --- Optional -----------------------------------------------------------------
# Comma-separated origins allowed to call this API from a browser. Unset means
# same-origin only, which is all the bundled front end needs.
# ALLOWED_ORIGINS=https://app.example.com

# Rumpty AI Inference — get these from the AI Inference tab in the Rumpty console
RUMPTY_AI_BASE_URL=https://api.rumptycloud.com/v1
RUMPTY_AI_KEY=your-api-key-here
RUMPTY_AI_MODEL=llama3.2:3b

# Optional tuning: per-attempt timeout in seconds, and how many times to retry
# a transient failure (timeout / connection error / 5xx). 4xx is never retried.
RUMPTY_AI_TIMEOUT=90
RUMPTY_AI_RETRIES=2

# Optional: full path to the Tesseract binary for image OCR. Only needed if it
# is not on PATH; on Windows the default install location is auto-detected.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
