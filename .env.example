# Local dev: public Postgres connection string
# On Rumpty deployment: use the internal connection string (app and DB both on Rumpty)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rentcheck

# Rumpty AI Inference — get these from the AI Inference tab in the Rumpty console
RUMPTY_AI_BASE_URL=https://api.rumptycloud.com/v1
RUMPTY_AI_KEY=your-api-key-here
RUMPTY_AI_MODEL=llama3.2:3b

# Optional tuning: per-attempt timeout in seconds, and how many times to retry
# a transient failure (timeout / connection error / 5xx). 4xx is never retried.
RUMPTY_AI_TIMEOUT=90
RUMPTY_AI_RETRIES=2

# Optional: full path to the Tesseract binary for image OCR. Only needed if it
# is not on PATH; on Windows the default install location is auto-detected.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
